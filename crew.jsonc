{
  "name": "android_crash_fix_agent",
  "agents": [
    "android_crash_analyst",
    "android_codebase_investigator",
    "android_fix_architect",
    "android_code_modifier",
    "android_build_verifier",
    "android_device_operator",
    "android_git_release_manager",
    "android_pr_report_compiler"
  ],
  "tasks": [
    {
      "name": "crash_intake_task",
      "description": "Analyze the raw Android crash context provided in {raw_crash_context}. Parse and extract the exception type, failing method or class, stack trace signals, likely affected Android layer, severity, reproduction clues, device or OS clues, app version clues, and missing information. Clearly separate confirmed facts from assumptions.",
      "expected_output": "A structured markdown crash intake report with sections: Summary, Confirmed Facts, Assumptions, Exception Type, Stack Trace Signals, Likely Affected Layer, Severity, Reproduction Clues, Missing Information, and Next Investigation Steps.",
      "agent": "android_crash_analyst",
      "markdown": true,
      "output_file": "output/crash_intake_report.md"
    },
    {
      "name": "codebase_investigation_task",
      "description": "Using the crash intake report and Android project path {android_project_path}, investigate which source files and Android components are related to the crash. You must call project_tree_tool to list relevant files, call project_search_tool to search for class names, file names, or patterns from the stack trace, and call file_read_tool to read small relevant files to understand the code context. Do not invent file paths; only discuss files verified by tools. If a file path is guessed but not found, clearly mark it as inferred/not found. CRITICAL CONSTRAINT: The investigation must only use file paths and contents confirmed by search/read tools, must mark any unconfirmed paths as inferred, and must not claim that any files were changed or edited.",
      "expected_output": "A structured markdown codebase investigation report with sections: Relevant Files, Relevant Components, Architecture Area, Search Queries Run, Findings, Evidence From Stack Trace, and Files To Inspect First.",
      "agent": "android_codebase_investigator",
      "context": [
        "crash_intake_task"
      ],
      "markdown": true,
      "output_file": "output/codebase_investigation.md"
    },
    {
      "name": "fix_planning_task",
      "description": "Using the crash intake report and codebase investigation report, analyze the target code logic and devise a safe and minimal Android crash fix plan. Identify the root cause, target files, recommended Kotlin or Compose edits, and validation checklist. The plan must contain the exact code blocks (Before and After) to be modified, including any required imports, so that the code modifier can apply them directly without ambiguity. CRITICAL CONSTRAINT: The fix plan must detail minimal changes only, providing exact search and replace blocks. Do not perform editing tools in this task, only plan the changes.",
      "expected_output": "A structured markdown fix plan with sections: Root Cause, Proposed Fix, Files To Modify, and Validation Steps. Include the exact code blocks (Before and After) for each modification.",
      "agent": "android_fix_architect",
      "context": [
        "crash_intake_task",
        "codebase_investigation_task"
      ],
      "markdown": true,
      "output_file": "output/fix_plan.md"
    },
    {
      "name": "code_modification_task",
      "description": "Using the approved fix plan from fix_planning_task and project path {android_project_path}, modify the target files. You MUST read the target files first, identify the exact lines of code that need to be changed, and call file_edit_tool to apply the correct replacement code (such as the resolveActivity check/try-catch and required imports in app/src/main/java/com/ananinja/tms/ui/home/HomeScreen.kt and app/src/main/AndroidManifest.xml). Do NOT make dummy replacements. Your replacement must solve the crash. CRITICAL CONSTRAINT: You must modify files strictly using the file_edit_tool and ensure the relative path and target/replacement code match exactly. Do not leave the file unchanged.",
      "expected_output": "A markdown modification log showing which files were edited and the output results returned by the file_edit_tool.",
      "agent": "android_code_modifier",
      "context": [
        "fix_planning_task"
      ],
      "markdown": true,
      "output_file": "output/modification_result.md"
    },
    {
      "name": "build_verification_task",
      "description": "Using the modification log and project path {android_project_path}, run build verification checks. You MUST call gradle_verify_tool with tasks [':app:compileDevDebugKotlin', ':app:compileDevDebugUnitTestKotlin'] to compile the app module and execute unit tests. If the build or tests fail, report the exact compiler error messages. CRITICAL CONSTRAINT: The verifier must compile changes and run unit tests strictly using the gradle_verify_tool with the specific app tasks and record results.",
      "expected_output": "A markdown verification report showing compilation status, exit codes, and unit test pass rates.",
      "agent": "android_build_verifier",
      "context": [
        "code_modification_task"
      ],
      "markdown": true,
      "output_file": "output/build_verification.md"
    },
    {
      "name": "device_verification_task",
      "description": "Using the build verification details, perform runtime and device checks. You MUST call adb_tool to list connected devices, launch the application if needed, and take verification screenshots to confirm device status. CRITICAL CONSTRAINT: You must use the adb_tool to capture device logs or take screenshots, and detail the captured artifacts.",
      "expected_output": "A markdown device verification log listing screenshots captured, connected devices, and logcat highlights.",
      "agent": "android_device_operator",
      "context": [
        "build_verification_task"
      ],
      "markdown": true,
      "output_file": "output/device_verification.md"
    },
    {
      "name": "git_release_task",
      "description": "Using the modified files and project path {android_project_path}, perform Git repository management. You MUST call git_tool to check the status, create a fresh git branch for the fix, commit only the modified source code files with a clear message (ensure you ignore and do not commit any .bak backup files), and prepare the Pull Request metadata. CRITICAL CONSTRAINT: You must verify that the modifications are successfully committed to a new git branch using the git_tool.",
      "expected_output": "A markdown git release report showing the created branch name, commit hash, and status of git changes.",
      "agent": "android_git_release_manager",
      "context": [
        "code_modification_task",
        "build_verification_task"
      ],
      "markdown": true,
      "output_file": "output/git_release.md"
    },
    {
      "name": "final_report_task",
      "description": "Consolidate the crash intake, codebase investigation, fix planning, modification logs, build verification, device verification screenshots, and git release branch details into a final PR-ready engineering report for the project at {android_project_path}.",
      "expected_output": "A final markdown PR report with sections: Title, Executive Summary, Crash Details, Root Cause Hypothesis, Modifications Made, Git Branch & Commit Status, Test Plan & Verification Results (showing build/test status), Manual QA Checklist, Risk Level, and Reviewer Checklist.",
      "agent": "android_pr_report_compiler",
      "context": [
        "crash_intake_task",
        "codebase_investigation_task",
        "fix_planning_task",
        "code_modification_task",
        "build_verification_task",
        "device_verification_task",
        "git_release_task"
      ],
      "markdown": true,
      "output_file": "output/pr_report.md"
    }
  ],
  "process": "sequential",
  "verbose": true,
  "memory": false,
  "inputs": {
    "raw_crash_context": "",
    "android_project_path": "/Users/retailopakistan/Documents/tp-app"
  }
}