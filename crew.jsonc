{
  "name": "android_crash_fix_agent",
  "agents": [
    "android_crash_analyst",
    "android_prompt_engineer",
    "android_antigravity_operator",
    "android_build_verifier",
    "android_device_operator",
    "android_git_release_manager",
    "android_pr_report_compiler"
  ],
  "tasks": [
    {
      "name": "crash_intake_task",
      "description": "Analyze the raw Android crash context provided in {raw_crash_context}. Parse and extract the exception type, failing method or class, stack trace signals, likely affected Android layer, severity, reproduction clues, device or OS clues, app version clues, and missing information. Clearly separate confirmed facts from assumptions.",
      "expected_output": "A structured markdown crash intake report with sections: Summary, Confirmed Facts, Assumptions, Exception Type, Stack Trace Signals, Likely Affected Layer, Severity, Reproduction Clues, Missing Information, and Next Investigation Steps.",
      "agent": "android_crash_analyst",
      "markdown": true,
      "output_file": "output/crash_intake_report.md"
    },
    {
      "name": "prompt_engineering_task",
      "description": "Using the crash intake report and Android project path {android_project_path}, write a comprehensive natural-language instruction brief for an autonomous coding agent to search the codebase, plan the fix, and apply edits. The brief must contain at minimum: 1. Objective: fix this specific crash safely and minimally. 2. Crash Summary: condensed from the intake report (exception type, failing method/class, stack trace, severity). 3. Investigation Instructions: instruction to explore the codebase (do not assume file paths) to locate the root cause. 4. Fix Constraints: minimal, lifecycle-safe, MVVM-consistent Compose/Kotlin changes only; do not add unrelated refactors; must not break existing tests. 5. Definition of Done: apply changes directly to the working tree, leave it ready for compilation. Crucially, the brief must include a fenced block clearly labeled 'FIX_INSTRUCTION' containing the exact single prompt string to be passed verbatim to 'agy -p'.",
      "expected_output": "A markdown engineering brief containing the prompt engineering result and a fenced code block labeled FIX_INSTRUCTION with the verbatim prompt string inside.",
      "agent": "android_prompt_engineer",
      "context": [
        "crash_intake_task"
      ],
      "markdown": true,
      "output_file": "output/antigravity_brief.md"
    },
    {
      "name": "antigravity_execution_task",
      "description": "Read output/antigravity_brief.md, extract the verbatim prompt string inside the FIX_INSTRUCTION fenced code block, and call antigravity_bridge_tool exactly once with the android_project_path and the extracted prompt as fix_instruction. CRITICAL CONSTRAINT: You must report a hard failure if the tool returns success: false, and list all changed files and diff stat on success.",
      "expected_output": "A markdown execution log showing the fix instruction sent, list of files changed, diff stat, and success/failure result.",
      "agent": "android_antigravity_operator",
      "context": [
        "prompt_engineering_task"
      ],
      "markdown": true,
      "output_file": "output/modification_result.md"
    },
    {
      "name": "build_verification_task",
      "description": "Using the modification log and project path {android_project_path}, run build verification checks. You MUST call gradle_verify_tool with tasks [':app:compileDevDebugKotlin', ':app:compileDevDebugUnitTestKotlin'] to compile the app module and execute unit tests. If the build or tests fail, report the exact compiler error messages. CRITICAL CONSTRAINT: The verifier must compile changes and run unit tests strictly using the gradle_verify_tool with the specific app tasks and record results.",
      "expected_output": "A markdown verification report showing compilation status, exit codes, and unit test pass rates.",
      "agent": "android_build_verifier",
      "context": [
        "antigravity_execution_task"
      ],
      "markdown": true,
      "output_file": "output/build_verification.md"
    },
    {
      "name": "device_verification_task",
      "description": "Using the build verification details, perform runtime and device checks. You MUST call adb_tool to list connected devices, launch the application if needed, and take verification screenshots to confirm device status. CRITICAL CONSTRAINT: You must use the adb_tool to capture device logs or take screenshots, and detail the captured artifacts.",
      "expected_output": "A markdown device verification log listing screenshots captured, connected devices, and logcat highlights.",
      "agent": "android_device_operator",
      "context": [
        "build_verification_task"
      ],
      "markdown": true,
      "output_file": "output/device_verification.md"
    },
    {
      "name": "git_release_task",
      "description": "Using the modified files and project path {android_project_path}, perform Git repository management. You MUST call git_tool to check the status, create a fresh git branch for the fix, commit only the modified source code files with a clear message (ensure you ignore and do not commit any .bak backup files), and prepare the Pull Request metadata. CRITICAL CONSTRAINT: You must verify that the modifications are successfully committed to a new git branch using the git_tool.",
      "expected_output": "A markdown git release report showing the created branch name, commit hash, and status of git changes.",
      "agent": "android_git_release_manager",
      "context": [
        "antigravity_execution_task",
        "build_verification_task"
      ],
      "markdown": true,
      "output_file": "output/git_release.md"
    },
    {
      "name": "final_report_task",
      "description": "Consolidate the crash intake, prompt engineering details, antigravity execution results, modification logs, build verification, device verification, and git release branch details into a final PR-ready engineering report for the project at {android_project_path}.",
      "expected_output": "A final markdown PR report with sections: Title, Executive Summary, Crash Details, Root Cause Hypothesis, Modifications Made, Git Branch & Commit Status, Test Plan & Verification Results (showing build/test status), Manual QA Checklist, Risk Level, and Reviewer Checklist.",
      "agent": "android_pr_report_compiler",
      "context": [
        "crash_intake_task",
        "prompt_engineering_task",
        "antigravity_execution_task",
        "build_verification_task",
        "device_verification_task",
        "git_release_task"
      ],
      "markdown": true,
      "output_file": "output/pr_report.md"
    }
  ],
  "process": "sequential",
  "verbose": true,
  "memory": false,
  "inputs": {
    "raw_crash_context": "",
    "android_project_path": "/Users/retailopakistan/Documents/tp-app"
  }
}