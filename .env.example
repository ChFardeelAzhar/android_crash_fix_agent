# DeepSeek API configuration (for agent logic reasoning)
DEEPSEEK_API_KEY=your_deepseek_api_key
LLM_PROVIDER=deepseek

# OpenAI config override for standard tool calling fallback
OPENAI_API_KEY=your_deepseek_api_key
OPENAI_API_BASE=https://api.deepseek.com

# Antigravity CLI Token (for agy CLI engine)
ANTIGRAVITY_TOKEN=your_antigravity_token

# GitHub API Credentials (for fetching issues/PRs/cards)
# Required scopes: 'repo' (read-access to target codebase repositories)
GITHUB_TOKEN=your_github_personal_access_token

# Jira API Credentials (for fetching Jira board cards/tickets)
# Token must be generated from Atlassian Account Settings
JIRA_EMAIL=your_jira_account_email@company.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_DOMAIN=your-domain.atlassian.net
